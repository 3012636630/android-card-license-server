{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DCC Java2C exact selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "required_methods"],
  "properties": {
    "schema_version": {"const": 1},
    "required_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^L[^;]+;->[^()]+\\([^)]*\\).+$"
      }
    }
  }
}
